# Upstream configuration.
#
# This tool speaks the Gemini native generateContent protocol, so any credential
# in that format works: an official Google AI Studio key against the default
# endpoint, or a key from a gateway that speaks the same protocol.
#
# GEMINI_BASE_URL is the endpoint root and the path is built from it. Leave it
# unset to use the official endpoint. Do not add /v1beta; GEMINI_API_VERSION
# supplies that part of the path.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=replace_with_image_model

# Official image models (all GA -- the -preview ids these replaced are retired):
#   gemini-3.1-flash-image       fastest generalist, the usual choice
#   gemini-3.1-flash-lite-image  cheaper and smaller, 1K output only
#   gemini-3-pro-image           highest quality, 4K, slowest
# gemini-2.5-flash-image shuts down 2026-10-02, so do not start there.

# For a gateway instead of the official endpoint, uncomment this and point it at
# the gateway root (e.g. http://127.0.0.1:3000). GEMINI_API_KEY is then that
# gateway's key, not a Google one.
# GEMINI_BASE_URL=http://127.0.0.1:3000

# The request the client sends:
#   POST {endpoint}/{GEMINI_API_VERSION}/models/{GEMINI_MODEL}:generateContent
# The API key travels in the x-goog-api-key header.
GEMINI_API_VERSION=v1beta
GEMINI_TIMEOUT=180

# Image output. IMAGE is what makes the model return a picture. Left commented
# out on purpose: unset means the default TEXT,IMAGE, which is what the official
# image models document as their own default. Set it to an EMPTY value to omit
# the field entirely if your endpoint rejects responseModalities -- an active
# line here would override that empty value and put the field back.
# GEMINI_RESPONSE_MODALITIES=TEXT,IMAGE

# Optional. Supported output sizes are model-specific: 512/1K/2K/4K on
# gemini-3.1-flash-image, 1K/2K/4K on gemini-3-pro-image, 1K on
# gemini-3.1-flash-lite-image. Asking for one your model does not offer is an
# error, not a hint, so leave this out unless you need it.
# GEMINI_IMAGE_SIZE=2K

# Google's own SDK variables (GOOGLE_API_KEY, GOOGLE_GEMINI_BASE_URL) are read as
# a fallback, but only when the GEMINI_* name above is absent from the
# environment altogether -- an empty GEMINI_API_KEY= is a decision, not an
# absence. Prefer the names above.

# Pixel output. PIXEL_SIZE is a density on a 256x256 reference canvas, not a
# literal output size. For example, a 1024x1024 source at 64x64 density becomes
# 256x256; non-square sources keep their aspect ratio.
PIXEL_SIZE=32x32
PIXEL_SCALE=4
PIXEL_MAX_COLORS=16
PIXEL_PALETTE=auto
PIXEL_KEEP_RAW=true
PIXEL_OUT_DIR=output

# Two image-model calls by default: an initial draft, local pixelization, then
# an automatic redraw of its contours and color clusters, followed by the final
# local pixelization. Set to 1 to compare with the old flow or reduce API usage.
# If the refinement call fails, the first draft is used.
PIXEL_GENERATION_PASSES=2

# Optional. {width} and {height} are replaced from the proportional output grid.
# PIXEL_PROMPT=Redraw the image as crisp pixel art on a {width}x{height} canvas. Preserve the subject and composition. No anti-aliasing, blur, gradients, text, or watermark. Return one image only.
# Optional second-pass prompt; {width} and {height} use the same output grid.
# PIXEL_REFINE_PROMPT=Repaint the first draft as deliberate pixel art with clean contours and coherent color clusters. Use the second image only for subject reference. Return one final image.

# Web UI (python3 pixel_web.py). The server binds 127.0.0.1 ONLY and must never
# be changed to 0.0.0.0: this process holds the API key, and a non-loopback
# address would also break the browser's clipboard API, which needs a secure
# context (localhost qualifies; a bare LAN IP does not).
PIXEL_WEB_PORT=8770

# Set to 0 to omit Python tracebacks from error responses. Leave unset (or 1)
# while debugging -- tracebacks are redacted of secrets before they are sent.
# PIXEL_WEB_DEBUG=1
