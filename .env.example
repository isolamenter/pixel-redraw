# NewAPI Gemini gateway
# NEWAPI_BASE_URL is the gateway root; the path is built from it. Do not add /v1beta.
NEWAPI_BASE_URL=http://127.0.0.1:3000
NEWAPI_API_KEY=replace_me
NEWAPI_MODEL=replace_with_image_model

# The client speaks the Gemini native protocol:
#   POST {NEWAPI_BASE_URL}/{NEWAPI_API_VERSION}/models/{NEWAPI_MODEL}:generateContent
# The API key is sent as the x-goog-api-key header.
NEWAPI_API_VERSION=v1beta
NEWAPI_TIMEOUT=180

# Image output. IMAGE is what makes the model return a picture. Leave this
# unset for the default (TEXT,IMAGE); set it to an empty value to omit the
# field entirely if the gateway rejects responseModalities.
NEWAPI_RESPONSE_MODALITIES=TEXT,IMAGE

# Optional. Some image models accept 1K, 2K or 4K. Omit to use the model default.
# NEWAPI_IMAGE_SIZE=2K

# Pixel output
PIXEL_SIZE=64x64
PIXEL_SCALE=8
PIXEL_MAX_COLORS=16
PIXEL_PALETTE=auto
PIXEL_KEEP_RAW=true
PIXEL_OUT_DIR=output

# Optional. {width} and {height} are replaced from PIXEL_SIZE.
# PIXEL_PROMPT=Redraw the image as crisp pixel art on a {width}x{height} canvas. Preserve the subject and composition. No anti-aliasing, blur, gradients, text, or watermark. Return one image only.

# Web UI (python3 pixel_web.py). The server binds 127.0.0.1 ONLY and must never
# be changed to 0.0.0.0: this process holds the API key, and a non-loopback
# address would also break the browser's clipboard API, which needs a secure
# context (localhost qualifies; a bare LAN IP does not).
PIXEL_WEB_PORT=8770

# Set to 0 to omit Python tracebacks from error responses. Leave unset (or 1)
# while debugging -- tracebacks are redacted of secrets before they are sent.
# PIXEL_WEB_DEBUG=1
